# 复制为 ~/.config/vidflow/.env 或直接 export。密钥不要提交。

# 文本 / 出图 / 视频（OpenAI 兼容网关）
VIDFLOW_API_KEY=
# 兼容旧名：
# MODELVERSEAPI_API_KEY=

# 配音（MiMo）
MIMO_API_KEY=

# 可选
# VIDFLOW_PROD=$HOME/production
# VIDFLOW_PROXY=http://127.0.0.1:10819
# VIDFLOW_TEXT_BASE=https://api.example.com/v1
# VIDFLOW_TEXT_MODEL=gemini-3.8-flash-high
# VIDFLOW_IMAGE_BASE=https://api.example.com/v1
# VIDFLOW_IMAGE_MODEL=gpt-image-2.5
# VIDFLOW_VIDEO_MODEL=grok-imagine-video-1.5
# VIDFLOW_WRITER_MODEL=gpt-6-astra
